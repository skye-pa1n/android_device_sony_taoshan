#!/system/bin/sh

# Wait a bit for the system to start up
sleep 5

# Dump logcat to /cache
logcat -d > /cache/logcat.txt

# Dump kernel messages to /cache
dmesg > /cache/dmesg.txt

# Optional: mark that the script ran
echo "bootanimation replaced - log dumped" > /cache/bootanim_debug.txt

# Prevent crash loop — fake bootanimation delay
sleep 60
